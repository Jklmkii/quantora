{
  "name": "quantora",
  "productName": "Quantora",
  "version": "1.2.9.1",
  "type": "module",
  "description": "Quantora — Suíte didática de matemática, ferramentas e desafios mentais",
  "author": {
    "name": "Lucas",
    "email": "suporte@local"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons": "electron scripts/generate-icons.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "node scripts/build-electron.cjs",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap open android",
    "apk:build": "node scripts/build-apk.cjs"
  },
  "build": {
    "appId": "com.quantora.desktop",
    "productName": "Quantora",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Jklmkii",
      "repo": "quantora"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Quantora",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "big.js": "^7.0.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/big.js": "^7.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.3",
    "oxlint": "^1.79.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
